import str

include "../core/model.salam"
include "../core/engine.salam"
include "../core/typing.salam"
include "../core/solve.salam"
include "../core/pretty.salam"

func typed(s: model.State, keys: str): model.State:
    mut n := s
    parts := str.Fields(keys)
    each key in parts:
        n = engine.Press(n, key)
    end
    ret n
end

func show(keys: str):
    s := typed(model.State {}, keys)
    shown := s.error != "" ? s.error : s.expr
    println keys, "->", shown
end

func previews(keys: str):
    s := typed(model.State {}, keys)
    println keys, "~>", solve.Preview(s)
end

func main:
    show("1 + 2 =")
    show(". 1 + . 2 =")
    show("2 + 3 * 4 =")
    show("( 2 + 3 ) * 4 =")
    show("1 0 / 4 =")
