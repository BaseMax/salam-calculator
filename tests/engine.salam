    show("2 + 3 = 7")
    show("2 + 3 = + 1 =")
    show("1 0 0 + 1 0 % =")
    show("1 0 0 - 1 0 % =")
    show("5 0 * 1 0 % =")
    show("5 0 % =")
    show("9 root =")
    show("root 2 =")
