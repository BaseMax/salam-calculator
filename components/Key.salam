pub component Key(action: str, send: func (str, str)):
    button:
        id = keys.Id(action)
        key = action
        grow = 1
        basis = 0
        min width = 0
        padding = 0
        border = "none"
        radius = skin.For(action).radius
        font size = skin.For(action).size
        font weight = "medium"
        color = skin.For(action).ink
        background = skin.For(action).face
        hover background = skin.For(action).hover
        active background = skin.For(action).pressed
        active scale = 0.96
        shadow = 0, 1, 3, "light dark(#1a140814, #00000040)"
        cursor = "pointer"
        selectable = false
        click = (): send("key", action) end
        content = keys.Label(action)
    end
end
