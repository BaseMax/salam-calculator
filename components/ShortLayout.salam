pub component ShortLayout(app: session.Session, send: func (str, str)):
    box:
        layout = "row"
        direction = "ltr"
        gap = 14
        grow = 1
        basis = 0
        min height = 0
        box:
            grow = 1
            basis = 0
            min width = 0
            Display:
                shown = app.shown
            end
        end
        box:
            grow = 1
            basis = 0
            min width = 0
            BottomPanel:
                app = app
                send = send
            end
        end
    end
end
