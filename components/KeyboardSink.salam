pub component KeyboardSink(send: func (str, str)):
    input:
        id = "keys"
        position = "absolute"
        top = 0
        left = 0
        width = 1
        height = 1
        opacity = 0
        border = "none"
        inputmode = "none"
        input = (v: str): send("typed", v) end
    end
end
