pub component ExpressionLine(text: str):
    paragraph:
        id = "above"
        key = "above-" + text
        margin = 0
        min height = 24
        direction = "ltr"
        text align = "right"
        font size = 18
        color = colors.Muted()
        content = text
    end
end
