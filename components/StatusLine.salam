pub component StatusLine(text: str, failed: bool):
    paragraph:
        id = "below"
        key = "below-" + text
        margin = 0
        min height = 28
        direction = "ltr"
        text align = "right"
        font size = failed ? 17 : 20
        color = failed ? colors.Danger() : colors.Muted()
        content = text
    end
end
