pub component TallLayout(app: session.Session, send: func (str, str)):
    box:
        grow = 1
        basis = 0
        min height = 0
        gap = 10
        Display:
            shown = app.shown
        end
        BottomPanel:
            app = app
            send = send
        end
    end
end
