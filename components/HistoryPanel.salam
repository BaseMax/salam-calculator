pub component HistoryPanel(entries: Vector<model.Entry>, send: func (str, str)):
    box:
        grow = 5
        basis = 0
        gap = 10
        min height = 0
        HistoryHeader:
            count = entries.Len()
            send = send
        end
        HistoryList:
            entries = entries
            send = send
        end
    end
end
