pub component HistoryList(entries: Vector<model.Entry>, send: func (str, str)):
    box:
        grow = 1
        basis = 0
        min height = 0
        gap = 8
        overflow y = "auto"
        if entries.Len() == 0:
            HistoryEmpty: end
        end
        each i, entry in entries:
            HistoryEntry:
                position = i
                source = entry.source
                result = entry.result
                send = send
            end
        end
    end
end
