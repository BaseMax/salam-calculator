pub component KeyRow(actions: str, send: func (str, str)):
    box:
        layout = "row"
        direction = "ltr"
        gap = 10
        grow = 1
        basis = 0
        min height = 40
        max height = 92
        each _, action in str.Fields(actions):
            Key:
                action = action
                send = send
            end
        end
    end
end
